# Docker Compose Override Example
# Copy this file to docker-compose.override.yml for local development

version: '3.8'

services:
  api:
    # Override for development with hot reload
    volumes:
      - ./app:/app/app:rw
    environment:
      - LOG_LEVEL=DEBUG
    ports:
      - "8000:8000"
  
  celery_worker:
    # Override for development
    volumes:
      - ./app:/app/app:rw
    environment:
      - LOG_LEVEL=DEBUG
  
  db:
    # Expose database port for local access
    ports:
      - "5432:5432"
    # Add persistent volume for local development
    volumes:
      - ./data/postgres:/var/lib/postgresql/data
  
  redis:
    # Expose Redis port for local access
    ports:
      - "6379:6379"
    # Add persistent volume for local development
    volumes:
      - ./data/redis:/data
